FROM dockcross/windows-static-x64:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    ca-certificates \
    python3 \
    && apt-get clean

ARG MXE_SYSROOT=/usr/src/mxe/usr/x86_64-w64-mingw32.static

# Build dependencies via MXE. NOTE: "sdl2" was dropped from this line -
# MXE has no "sdl3" package upstream (only sdl.mk for SDL 1.2 and sdl2.mk
# for SDL2), so SDL3 has to be built from source below, the same way
# Assimp already is a few steps down.
RUN cd /usr/src/mxe && \
    make fmt spdlog zlib -j$(nproc) MXE_TARGETS='x86_64-w64-mingw32.static'

# Build GLFW 3.5.1 statically (instead of using MXE's outdated glfw3)
RUN wget -q https://github.com/glfw/glfw/releases/download/3.5.1/glfw-3.5.1.zip && \
    unzip glfw-3.5.1.zip && \
    cd glfw-3.5.1 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DGLFW_BUILD_EXAMPLES=OFF \
    -DGLFW_BUILD_TESTS=OFF \
    -DGLFW_BUILD_DOCS=OFF && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf glfw-3.5.1*

# Build SDL3 statically from source. The dockcross base image already has
# CC/CXX/AR/RANLIB/etc pointed at the MXE x86_64-w64-mingw32.static
# cross-compiler, so a plain out-of-tree CMake build cross-compiles
# correctly with no extra toolchain flags - same pattern used for Assimp
# below. This installs SDL3's headers, static lib, and sdl3.pc into the
# MXE sysroot so CMakeLists.txt's `pkg_check_modules(SDL3 REQUIRED sdl3)`
# can find it.
RUN wget -q https://github.com/libsdl-org/SDL/releases/download/release-3.4.14/SDL3-3.4.14.tar.gz && \
    tar xzf SDL3-3.4.14.tar.gz && \
    cd SDL3-3.4.14 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DSDL_STATIC=ON \
    -DSDL_SHARED=OFF \
    -DSDL_TESTS=OFF \
    -DSDL_HIDAPI=ON \
    -DSDL_HIDAPI_JOYSTICK=ON \
    && make -j$(nproc) && \
    make install && \
    cd ../../.. && rm -rf SDL3-3.4.14*

# nlohmann_json header-only
RUN mkdir -p ${MXE_SYSROOT}/include/nlohmann && \
    wget -q https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp \
    -O ${MXE_SYSROOT}/include/nlohmann/json.hpp && \
    mkdir -p ${MXE_SYSROOT}/lib/pkgconfig && \
    printf 'prefix=%s\nincludedir=${prefix}/include\n\nName: nlohmann_json\nDescription: JSON for Modern C++\nVersion: 3.11.3\nCflags: -I${includedir}\n' "${MXE_SYSROOT}" \
    > ${MXE_SYSROOT}/lib/pkgconfig/nlohmann_json.pc

# Build Assimp
RUN wget -q https://github.com/assimp/assimp/archive/refs/tags/v5.4.3.tar.gz && \
    tar xzf v5.4.3.tar.gz && \
    cd assimp-5.4.3 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DBUILD_SHARED_LIBS=OFF \
    -DASSIMP_BUILD_TESTS=OFF \
    -DASSIMP_BUILD_SAMPLES=OFF \
    -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
    -DASSIMP_BUILD_BLENDER_IMPORTER=OFF \
    -DASSIMP_WARNINGS_AS_ERRORS=OFF && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf assimp-5.4.3*

# Verify pkg-config files (sdl2 -> sdl3)
RUN for pc in assimp glfw3 sdl3 fmt spdlog nlohmann_json; do \
    ls -l ${MXE_SYSROOT}/lib/pkgconfig/${pc}.pc || \
    (echo "MISSING: ${pc}.pc" && find ${MXE_SYSROOT} -iname "${pc}*.pc"); \
    done

WORKDIR /app
COPY . /app

RUN mkdir build && cd build && \
    cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-static-libgcc -static-libstdc++" \
    -DBUILD_STATIC=ON && \
    make -j$(nproc)

CMD ["sh", "-c", "mkdir -p /dist/windows && cp /app/build/3dco+.exe /dist/windows/"]