FROM dockcross/windows-static-x64:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    ca-certificates \
    python3 \
    && apt-get clean

ARG MXE_SYSROOT=/usr/src/mxe/usr/x86_64-w64-mingw32.static

# Build dependencies via MXE. NOTE: "sdl2" was dropped from this line -
# MXE has no "sdl3" package upstream (only sdl.mk for SDL 1.2 and sdl2.mk
# for SDL2), so SDL3 has to be built from source below, the same way
# Assimp already is a few steps down.
RUN cd /usr/src/mxe && \
    make fmt spdlog zlib -j$(nproc) MXE_TARGETS='x86_64-w64-mingw32.static'

# Build GLFW 3.5.1 statically (instead of using MXE's outdated glfw3)
RUN wget -q https://github.com/glfw/glfw/releases/download/3.5.1/glfw-3.5.1.zip && \
    unzip glfw-3.5.1.zip && \
    cd glfw-3.5.1 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DGLFW_BUILD_EXAMPLES=OFF \
    -DGLFW_BUILD_TESTS=OFF \
    -DGLFW_BUILD_DOCS=OFF && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf glfw-3.5.1*

# Build SDL3 statically from source. The dockcross base image already has
# CC/CXX/AR/RANLIB/etc pointed at the MXE x86_64-w64-mingw32.static
# cross-compiler, so a plain out-of-tree CMake build cross-compiles
# correctly with no extra toolchain flags - same pattern used for Assimp
# below. This installs SDL3's headers, static lib, and sdl3.pc into the
# MXE sysroot so CMakeLists.txt's `pkg_check_modules(SDL3 REQUIRED sdl3)`
# can find it.
RUN wget -q https://github.com/libsdl-org/SDL/releases/download/release-3.4.14/SDL3-3.4.14.tar.gz && \
    tar xzf SDL3-3.4.14.tar.gz && \
    cd SDL3-3.4.14 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DSDL_STATIC=ON \
    -DSDL_SHARED=OFF \
    -DSDL_TESTS=OFF \
    -DSDL_HIDAPI=ON \
    -DSDL_HIDAPI_JOYSTICK=ON \
    && make -j$(nproc) && \
    make install && \
    cd ../../.. && rm -rf SDL3-3.4.14*

# nlohmann_json header-only
RUN mkdir -p ${MXE_SYSROOT}/include/nlohmann && \
    wget -q https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp \
    -O ${MXE_SYSROOT}/include/nlohmann/json.hpp && \
    mkdir -p ${MXE_SYSROOT}/lib/pkgconfig && \
    printf 'prefix=%s\nincludedir=${prefix}/include\n\nName: nlohmann_json\nDescription: JSON for Modern C++\nVersion: 3.11.3\nCflags: -I${includedir}\n' "${MXE_SYSROOT}" \
    > ${MXE_SYSROOT}/lib/pkgconfig/nlohmann_json.pc

# Build Assimp
RUN wget -q https://github.com/assimp/assimp/archive/refs/tags/v5.4.3.tar.gz && \
    tar xzf v5.4.3.tar.gz && \
    cd assimp-5.4.3 && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=${MXE_SYSROOT} \
    -DBUILD_SHARED_LIBS=OFF \
    -DASSIMP_BUILD_TESTS=OFF \
    -DASSIMP_BUILD_SAMPLES=OFF \
    -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
    -DASSIMP_BUILD_BLENDER_IMPORTER=OFF \
    -DASSIMP_WARNINGS_AS_ERRORS=OFF && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf assimp-5.4.3*

# Verify pkg-config files (sdl2 -> sdl3)
RUN for pc in assimp glfw3 sdl3 fmt spdlog nlohmann_json; do \
    ls -l ${MXE_SYSROOT}/lib/pkgconfig/${pc}.pc || \
    (echo "MISSING: ${pc}.pc" && find ${MXE_SYSROOT} -iname "${pc}*.pc"); \
    done

WORKDIR /app
COPY . /app

# RelWithDebInfo instead of Release: keeps the same optimization level
# (-O2, effectively identical performance and behavior to Release) but
# additionally passes -g, embedding DWARF debug info directly in the
# .exe - no separate .pdb needed for a MinGW/GCC build. Without this,
# a crash dump can only ever be resolved to raw module+offset, useless
# for actually diagnosing a bug. Debug info gets split back out below
# (see the CMD) so the .exe actually shipped to testers stays small.
RUN mkdir build && cd build && \
    cmake .. \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_CXX_FLAGS="-static-libgcc -static-libstdc++" \
    -DBUILD_STATIC=ON && \
    make -j$(nproc)

# Split debug info out of the shipped .exe rather than going back to a
# plain Release build and losing it entirely: 3dco+.exe below is what
# actually goes to the tester (small again - the debug info
# RelWithDebInfo added is removed from it), while 3dco+.debug keeps
# every symbol from this exact build, for you to keep on your own
# side. If a future crash report ever needs investigating again, no
# rebuild is needed - keep that build's .exe and .debug archived
# together (matching versions matter) and open the .dmp in WinDbg as
# before.
#
# Written to its own script file (heredoc below) rather than inlined
# directly into CMD, so its logic can use normal, multi-line shell
# control flow without fighting Dockerfile's own line-continuation
# rules layered on top of it - a first attempt at inlining this got
# tangled in exactly that and silently never actually found objcopy,
# shipping the full, unstripped .exe every time with no visible error.
#
# Tries several ways to locate objcopy rather than a single,
# hardcoded name or the -print-prog-name=objcopy trick alone (which
# didn't resolve correctly through this particular toolchain's
# compiler wrapper) - most specific/likely first, broadest last - and
# always prints which one it used (or that none worked) plus the
# final /dist/windows listing, so a build log always shows plainly
# whether the split actually happened rather than failing silently.
RUN cat > /package.sh << 'PACKAGE_SCRIPT_EOF'
#!/bin/sh
set -e
mkdir -p /dist/windows
cp /app/build/3dco+.exe /dist/windows/3dco+.exe
echo "Pre-strip size: $(du -h /dist/windows/3dco+.exe | cut -f1)"

OBJCOPY=""
for candidate in \
    x86_64-w64-mingw32.static-objcopy \
    x86_64-w64-mingw32-objcopy \
    "$(command -v x86_64-w64-mingw32.static-objcopy 2>/dev/null)" \
    "$(command -v x86_64-w64-mingw32-objcopy 2>/dev/null)" \
    "$(x86_64-w64-mingw32.static-g++ -print-prog-name=objcopy 2>/dev/null)" \
    "$(find /usr/src/mxe /usr -iname '*mingw32*objcopy*' -type f 2>/dev/null | head -1)"
do
    if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
        OBJCOPY="$candidate"
        echo "Found objcopy: $OBJCOPY"
        break
    fi
done

if [ -n "$OBJCOPY" ]; then
    "$OBJCOPY" --only-keep-debug /dist/windows/3dco+.exe /dist/windows/3dco+.debug
    "$OBJCOPY" --strip-debug --strip-unneeded /dist/windows/3dco+.exe
    "$OBJCOPY" --add-gnu-debuglink=/dist/windows/3dco+.debug /dist/windows/3dco+.exe
    echo "Split debug info using $OBJCOPY"
else
    echo "objcopy NOT FOUND after trying all candidates - shipping 3dco+.exe with debug info still embedded"
fi

echo "--- final /dist/windows contents ---"
ls -la /dist/windows/
PACKAGE_SCRIPT_EOF
RUN chmod +x /package.sh

CMD ["/bin/sh", "/package.sh"]